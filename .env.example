# ===========================================================================
# MODELO DE CONFIGURAÇÃO
#
# Copie este arquivo para `.env.local` e preencha os valores.
# No Netlify/Vercel, cadastre cada uma como variável de ambiente no painel
# do provedor — o `.env.local` NÃO sobe junto (está no .gitignore).
# ===========================================================================

# --- GATEWAY DE PAGAMENTO --------------------------------------------------
# Qual gateway usar. Hoje só existe "gorillapay".
PAYMENT_GATEWAY=gorillapay

# Chave da API (GorillaPay Dashboard → API Keys). Começa com sk_live_
GATEWAY_API_KEY=

# Segredo do webhook (GorillaPay Dashboard → Settings → Webhooks).
# Sem ele, os avisos de pagamento são recusados — a confirmação passa a
# depender só do polling do /api/check-payment.
GATEWAY_WEBHOOK_SECRET=

# --- BANCO DE DADOS --------------------------------------------------------
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- PAINEL /admin ---------------------------------------------------------
# A senha do painel. Vazia = as rotas /api/admin/* respondem 404.
ADMIN_TOKEN=

# --- OPCIONAL --------------------------------------------------------------
# Token da UTMify, se for usar. Sem ele o envio é ignorado em silêncio.
UTMIFY_TOKEN=
